{
  "name": "yt-engine",
  "version": "0.1.0",
  "description": "Desktop application for YouTube content automation",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "electron": "wait-on tcp:3000 && electron .",
    "dev:electron": "concurrently -k \"cross-env BROWSER=none npm run dev\" \"npm run electron\"",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@xzdarcy/react-timeline-editor": "^0.1.9",
    "adm-zip": "^0.5.16",
    "better-sqlite3": "^12.5.0",
    "electron-is-dev": "^3.0.1",
    "fluent-ffmpeg": "^2.1.3",
    "lucide-react": "^0.561.0",
    "next": "16.0.10",
    "node-fetch": "^2.7.0",
    "react": "19.2.1",
    "react-countup": "^6.5.3",
    "react-dom": "19.2.1",
    "systeminformation": "^5.27.14",
    "yt-dlp-exec": "^1.0.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "eslint": "^9",
    "eslint-config-next": "16.0.10",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^9.0.3"
  },
  "build": {
    "appId": "com.ytengine.app",
    "productName": "YTEngine",
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "files": [
      "out/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
